# --- 数据库 / 缓存 ---
DATABASE_URL=postgresql://saas:saas@postgres:5432/listing?schema=public
REDIS_URL=redis://redis:6379

# --- 会话 / 加密 ---
# 用 `openssl rand -hex 32` 生成
SESSION_SECRET=change-me-session-secret-please
# AES-256-GCM 密钥，32 字节，base64 编码；用 `openssl rand -base64 32` 生成
APP_ENCRYPTION_KEY=change-me-encryption-key-please

# --- 对象存储（MinIO / S3 兼容） ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=listing-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/listing-assets
S3_FORCE_PATH_STYLE=true

# --- Ozon ---
OZON_API_BASE=https://api-seller.ozon.ru
# true 才会真实提交 Ozon；false 只打 mock，返回假 task_id
ENABLE_REAL_OZON_SUBMIT=false

# --- 象寄 ---
XIANGJI_API_BASE=https://api.tosoiot.com
