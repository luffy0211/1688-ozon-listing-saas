# --- 数据库 / 缓存 ---
DATABASE_URL=postgresql://saas:saas@postgres:5432/listing?schema=public
REDIS_URL=redis://redis:6379

# --- 会话 / 加密 ---
# 用 `openssl rand -hex 32` 生成
SESSION_SECRET=dev-session-secret-change-before-production
# AES-256-GCM 密钥，32 字节，base64 编码；用 `openssl rand -base64 32` 生成
APP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- 对象存储（MinIO / S3 兼容） ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=listing-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/listing-assets
S3_FORCE_PATH_STYLE=true

# --- Ozon ---
OZON_API_BASE=https://api-seller.ozon.ru
# true 才会真实提交 Ozon；false 只打 mock，返回假 task_id
ENABLE_REAL_OZON_SUBMIT=false
OZON_PRICE_CURRENCY_CODE=RUB

# --- OpenAI Agent ---
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=
# true: local deterministic agent path; false: call OpenAI Agents SDK.
OPENAI_AGENT_MOCK=true
OPENAI_AGENT_TRACE_SENSITIVE_DATA=false
AGENT_MIN_MARGIN_RATE=0.25
AGENT_MIN_PROFIT_RUB=100
AGENT_COMPETITOR_CACHE_HOURS=24
# 本地采集器不可用时，竞品分析回退使用 Tavily 搜索索引
TAVILY_API_KEY=
# 配置 Cookie 后优先使用本地纯 HTTP Ozon 采集器；TSV 与 JAR 二选一
OZON_CRAWLER_PYTHON=python
OZON_CRAWLER_SCRIPT=
OZON_CRAWLER_COOKIE_JAR=
OZON_CRAWLER_COOKIE_TSV=
OZON_CRAWLER_PROXY=socks5h://127.0.0.1:10808
OZON_CRAWLER_SCAN_PAGES=5
OZON_CRAWLER_TIMEOUT_MS=900000

# --- 象寄 ---
XIANGJI_API_BASE=https://api.tosoiot.com
XIANGJI_MOCK=true
XIANGJI_AUTH_MODE=x-api-key
XIANGJI_TEXT_MOCK=true
XIANGJI_PDP_MOCK=true
XIANGJI_USER_KEY=
XIANGJI_TEXT_TRANS_KEY=

# --- Worker ---
WORKER_CONCURRENCY=2

# --- 本地 seed ---
SEED_TENANT_NAME=本地演示租户
INITIAL_INVITE_CODE=dev-invite
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123456
