{
  "name": "@saas/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "start": "node --import tsx src/index.ts",
    "start:agent-only": "node --import tsx src/agent-only.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@saas/core": "workspace:*",
    "@saas/db": "workspace:*",
    "@saas/ozon": "workspace:*",
    "@saas/xiangji": "workspace:*",
    "bullmq": "^5.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
